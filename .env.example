# =============================================================================
# MODELO — copie para .env.local e preencha ( .env.local NÃO vai para o Git )
#   cp .env.example .env.local
# Documentação: docs/ENVIRONMENT.md
# =============================================================================

# --- Obrigatório (app + Python analytics) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Desenvolvimento local (sem Neon): após `brew install postgresql@16` e `createdb financial_advisor`
# DATABASE_URL="postgresql://localhost/financial_advisor"

# --- Chaves de API (ingestão QI) — mesmo ficheiro para Next.js e Python ---
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=""
# Polygon (preços diários OHLCV → qi_market_price_daily): https://polygon.io/
POLYGON_API_KEY=""
# Opcional — fundamentais (perfil/setor GICS; dashboard em financialmodelingprep.com)
# Inserir no terminal com máscara: npm run env:keys
# FMP_API_KEY=""

# --- Crons Next.js (Bearer em GET /api/cron/*) ---
# openssl rand -base64 32
CRON_SECRET=""

# --- Auth (só se AUTH_ENABLED=true) ---
# AUTH_ENABLED="true"
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Quantitative intelligence (Python `analytics/`) ---
# QI_MODEL_VERSION="v0.1.0"
# QI_RUN_PYTHON="true"
# QI_PYTHON_BIN="python3"
# QI_JOB="all"
# QI_POLYGON_MAX_ASSETS="40"
# QI_UNIVERSE_MAX_PER_SECTOR="120"
# QI_AS_OF_DATE="2026-04-01"
#
# QI Pipeline — gate FRED → Polygon (ver analytics/README.md)
# QI_MIN_FRED_PCT="0"
# QI_FRED_BACKFILL_START="2020-01-01"
#
# Fases do pipeline Python de ingestão QI.
# Valores possíveis: fred, polygon, fmp (separados por vírgula) ou "all" / vazio = todas.
# Omitir "fred" quando o cron TS qi-macro já gere FRED diariamente (recomendado em produção).
# QI_INGEST_PHASE="polygon,fmp"
#
# Desenvolvimento local (FRED também no Python):
# QI_INGEST_PHASE="fred,polygon,fmp"
# Lotes (Polygon/FMP) — ver docs de ingest em lotes
# QI_INGEST_BATCH_SIZE="50"
# FMP fundamentals (qi_fundamental_snapshot); 0 = todos os ativos activos
# QI_FMP_MAX_ASSETS="0"
# QI_FMP_DELAY_SEC="0.12"
#
# Descoberta de ativos (Polygon /v3/reference/tickers → qi_asset)
# QI_DISCOVER_TYPES="CS,ETF"
# QI_DISCOVER_LIMIT="50000"
# QI_DISCOVER_DELAY_SEC="0.25"
# QI_DISCOVER_MIN_MARKETCAP=""
#
# Por defeito, crons TS não gravam regime/setores/recomendação (fonte: Python).
# QI_ALLOW_TS_QI_WRITERS="true"

# --- Opcional ---
# AUTH_URL="https://seu-projeto.vercel.app"
